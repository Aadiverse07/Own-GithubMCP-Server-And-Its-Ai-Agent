# Copy to .env and fill in. NEVER commit .env. NEVER export these in your shell profile.
# Throwaway GitHub account only (fine-grained PAT limited to the fixture repo).
GITHUB_TOKEN=
GITHUB_ALLOWED_REPOS=testuser/mcp-fixture-repo
GITHUB_DEFAULT_REPO=testuser/mcp-fixture-repo
GITHUB_TIMEOUT_S=15
DESCRIPTION_VERSION=tools-v1
LOG_DIR=logs
LOG_LEVEL=INFO
# Read ONLY by the live smoke guard (not by the server): comma-separated logins that must never be used.
GHMCP_FORBIDDEN_LOGINS=
